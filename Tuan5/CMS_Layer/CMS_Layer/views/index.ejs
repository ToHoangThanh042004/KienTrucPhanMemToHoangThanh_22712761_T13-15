<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Professional CMS Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        /* Tùy chỉnh thanh cuộn màu xanh cho đồng bộ */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #10b981; border-radius: 10px; }
    </style>
</head>
<body class="bg-[#f0f9f6] flex"> <aside class="w-72 bg-white h-screen sticky top-0 border-r border-emerald-100 flex flex-col shadow-sm">
        <div class="p-8">
            <div class="flex items-center gap-3 mb-10">
                <div class="w-10 h-10 bg-gradient-to-br from-emerald-400 to-teal-600 rounded-xl flex items-center justify-center text-white shadow-lg shadow-emerald-200">
                    <span class="text-xl font-bold">C</span>
                </div>
                <h1 class="text-xl font-bold text-slate-800 tracking-tight">CMS <span class="text-emerald-600">Layered</span></h1>
            </div>

            <nav class="space-y-2">
                <a href="#" class="flex items-center gap-3 px-4 py-3 bg-emerald-500 text-white rounded-xl font-semibold shadow-md shadow-emerald-100 transition-all">
                    <span>🏠</span> Tổng quan
                </a>
                <a href="#" class="flex items-center gap-3 px-4 py-3 text-slate-500 hover:bg-emerald-50 hover:text-emerald-700 rounded-xl transition-all group">
                    <span class="group-hover:scale-110 transition-transform">📄</span> Bài viết
                </a>
                <a href="#" class="flex items-center gap-3 px-4 py-3 text-slate-500 hover:bg-emerald-50 hover:text-emerald-700 rounded-xl transition-all group">
                    <span class="group-hover:scale-110 transition-transform">🖼️</span> Media
                </a>
                <a href="#" class="flex items-center gap-3 px-4 py-3 text-slate-500 hover:bg-emerald-50 hover:text-emerald-700 rounded-xl transition-all group">
                    <span class="group-hover:scale-110 transition-transform">⚙️</span> Cấu hình
                </a>
            </nav>
        </div>

        <div class="mt-auto p-8">
            <div class="bg-emerald-900 rounded-2xl p-4 text-white shadow-inner">
                <p class="text-xs text-emerald-300 mb-1 font-medium">Kiến trúc hệ thống</p>
                <p class="text-sm font-bold uppercase tracking-wider">4-Layer Architecture</p>
            </div>
        </div>
    </aside>

    <main class="flex-1 p-10 overflow-y-auto">
        
        <header class="flex justify-between items-center mb-12">
            <div>
                <h2 class="text-3xl font-bold text-slate-900">Dashboard</h2>
                <p class="text-emerald-600/70 font-medium">Hệ thống đang hoạt động ổn định trên Node.js</p>
            </div>
            <div class="flex items-center gap-4 bg-white p-2 pr-6 rounded-full shadow-sm border border-emerald-50">
                <div class="w-12 h-12 rounded-full border-2 border-emerald-400 shadow-sm overflow-hidden">
                    <img src="https://ui-avatars.com/api/?name=Admin+CMS&background=10b981&color=fff" alt="avatar">
                </div>
                <div class="text-left">
                    <p class="text-sm font-bold text-slate-800 leading-none">Quản trị viên</p>
                    <p class="text-[10px] text-emerald-500 font-bold uppercase mt-1 tracking-tighter">Online</p>
                </div>
            </div>
        </header>

        <div class="grid grid-cols-12 gap-8">
            
            <div class="col-span-12 lg:col-span-4">
                <div class="bg-white rounded-[2.5rem] p-8 border border-emerald-100 shadow-sm sticky top-10">
                    <div class="flex items-center gap-3 mb-6">
                        <span class="p-2 bg-emerald-100 rounded-lg">🖋️</span>
                        <h3 class="text-xl font-bold text-slate-800">Soạn thảo</h3>
                    </div>
                    
                    <form action="/add-post" method="POST" class="space-y-5">
                        <div>
                            <label class="block text-sm font-semibold text-slate-500 mb-2 ml-1">Tiêu đề bài viết</label>
                            <input type="text" name="title" placeholder="Hôm nay bạn muốn chia sẻ gì?" required
                                class="w-full px-5 py-4 rounded-2xl bg-slate-50 border border-slate-100 focus:ring-4 focus:ring-emerald-500/10 focus:border-emerald-500 focus:bg-white outline-none transition-all placeholder:text-slate-300">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-slate-500 mb-2 ml-1">Nội dung chi tiết</label>
                            <textarea name="content" rows="5" placeholder="Nội dung sẽ được xử lý qua Tầng Logic..."
                                class="w-full px-5 py-4 rounded-2xl bg-slate-50 border border-slate-100 focus:ring-4 focus:ring-emerald-500/10 focus:border-emerald-500 focus:bg-white outline-none transition-all placeholder:text-slate-300"></textarea>
                        </div>
                        <button type="submit" class="w-full bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-bold py-4 rounded-2xl shadow-xl shadow-emerald-200 transition-all hover:-translate-y-1 active:scale-95 flex justify-center items-center gap-2">
                            <span>✨</span> Xuất bản bài viết
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-span-12 lg:col-span-8">
                <div class="flex items-center justify-between mb-6 px-2">
                    <h3 class="text-xl font-bold text-slate-800 flex items-center gap-2">
                        Bài viết mới nhất
                        <span class="w-2 h-2 bg-emerald-500 rounded-full animate-ping"></span>
                    </h3>
                    <div class="flex gap-2">
                        <span class="px-4 py-1.5 bg-emerald-100 text-emerald-700 text-xs font-bold rounded-full shadow-sm">
                            MYSQL: CONNECTED
                        </span>
                    </div>
                </div>

                <div class="space-y-5">
                    <% if (posts.length === 0) { %>
                        <div class="bg-white rounded-[2rem] p-16 text-center border-2 border-dashed border-emerald-100">
                            <div class="text-5xl mb-4 text-emerald-100">🍃</div>
                            <p class="text-slate-400 font-medium italic">Kho lưu trữ đang chờ bài viết đầu tiên...</p>
                        </div>
                    <% } %>

                    <% posts.forEach(function(post) { %>
                        <div class="bg-white rounded-[2rem] p-7 border border-emerald-50 shadow-sm hover:shadow-xl hover:shadow-emerald-500/5 transition-all group relative overflow-hidden">
                            <div class="absolute left-0 top-0 bottom-0 w-1 bg-emerald-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                            
                            <div class="flex justify-between items-start mb-4">
                                <div class="flex-1">
                                    <h4 class="text-lg font-bold text-slate-800 group-hover:text-emerald-600 transition-colors duration-300">
                                        <%= post.title %>
                                    </h4>
                                    <p class="text-slate-500 text-sm mt-3 leading-relaxed line-clamp-2">
                                        <%= post.content %>
                                    </p>
                                </div>
                                <div class="bg-slate-50 px-3 py-1 rounded-full border border-slate-100">
                                    <span class="text-[10px] font-black text-slate-400">ID #<%= post.id %></span>
                                </div>
                            </div>
                            
                            <div class="flex items-center gap-3 pt-5 border-t border-slate-50">
                                <div class="flex items-center gap-2 bg-emerald-50 px-4 py-2 rounded-xl group-hover:bg-emerald-100 transition-colors">
                                    <span class="text-xs font-bold text-emerald-700">🏷️ SEO: <%= post.seoTitle %></span>
                                </div>
                                
                                <div class="ml-auto flex items-center gap-1">
                                    <button class="w-10 h-10 flex items-center justify-center rounded-xl text-slate-400 hover:bg-blue-50 hover:text-blue-500 transition-all">✏️</button>
                                    <button class="w-10 h-10 flex items-center justify-center rounded-xl text-slate-400 hover:bg-red-50 hover:text-red-500 transition-all">🗑️</button>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>

        </div>
    </main>

</body>
</html>